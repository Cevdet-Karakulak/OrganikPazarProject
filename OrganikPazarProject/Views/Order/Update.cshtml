@model OrganikPazar.Entities.Order

@{
    ViewData["Title"] = "Update";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Sipariş Güncelle</h2>

<form asp-action="Update" method="post">
    <input type="hidden" asp-for="Orderid" />

    <div class="form-group">
        <label>Müşteri</label>
        <select asp-for="Customerid" asp-items="ViewBag.Customers" class="form-control"></select>
    </div>

    <div class="form-group">
        <label>Ürün</label>
        <select asp-for="Productid" asp-items="ViewBag.Products" class="form-control"></select>
    </div>

    <div class="form-group">
        <label>Adet</label>
        <input asp-for="Quantity" class="form-control" />
    </div>

    <div class="form-group">
        <label>Toplam Fiyat (TL)</label>
        <input asp-for="Totalprice" class="form-control" />
    </div>

    <div class="form-group">
        <label>Şehir</label>
        <input asp-for="City" class="form-control" />
    </div>

    <div class="form-group">
        <label>Durum</label>
        <input asp-for="Status" class="form-control" />
    </div>

    <div class="form-group">
        <label>Sipariş Tarihi</label>
        <input asp-for="Orderdate" class="form-control" type="date"
               value="@Model.Orderdate?.ToString("yyyy-MM-dd")" />
    </div>

    <button type="submit" class="btn btn-success">Güncelle</button>
    <a href="/Order" class="btn btn-secondary">İptal</a>
</form>
