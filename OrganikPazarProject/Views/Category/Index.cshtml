@model List<OrganikPazar.Entities.Category>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Kategori Listesi</h2>

<a class="btn btn-success mb-3" href="/Category/Create">Yeni Kategori Ekle</a>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Kategori Adı</th>
            <th>Açıklama</th>
            <th>Güncelle</th>
            <th>Sil</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Categoryid</td>
                <td>@item.Categoryname</td>
                <td>@item.Description</td>
                <td>
                    <a href="/Category/Update/@item.Categoryid" class="btn btn-warning btn-sm">Güncelle</a>
                </td>
                <td>
                    <a href="/Category/Delete/@item.Categoryid" class="btn btn-danger btn-sm" onclick="return confirm('Bu ürünü silmek istediğine emin misin?');">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>

