@model List<OrganikPazar.Entities.Log>
@using OrganikPazar.Helpers

<div class="card shadow-sm border-0">
    
    <div class="card-body bg-light p-3">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle text-center mb-0">
                    <thead class="table-primary text-dark">
                        <tr>
                            <th>Kullanıcı</th>
                            <th>Tablo</th>
                            <th>IP Adresi</th>
                            <th>İşlem Türü</th>
                            <th>Zaman</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@log.Username</td>
                                <td>@log.Entity</td>
                                <td>
                                    <i class="fa fa-globe text-primary"></i>
                                    <span class="text-muted">@log.IpAddress</span>
                                </td>
                                <td>
                                    @switch (log.Actiontype)
                                    {
                                        case "Create":
                                            <span class="badge bg-success px-3 py-2">Ekleme</span>
                                            break;
                                        case "Update":
                                            <span class="badge bg-warning text-dark px-3 py-2">Güncelleme</span>
                                            break;
                                        case "Delete":
                                            <span class="badge bg-danger px-3 py-2">Silme</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary px-3 py-2">@log.Actiontype</span>
                                            break;
                                    }
                                </td>
                                <td class="text-muted">@DateHelper.ToRelativeTime(log.Actiondate)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted text-center my-2">Hiç log kaydı bulunamadı.</p>
        }
    </div>
</div>

<style>
    .card {
        border-radius: 10px;
    }

    .table th {
        font-weight: 600;
    }

    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
        transition: 0.2s ease-in-out;
    }

    .badge {
        font-size: 0.8rem;
        border-radius: 8px;
    }

    .text-muted {
        font-size: 0.85rem;
    }

    .fa-globe {
        margin-right: 5px;
    }
</style>
