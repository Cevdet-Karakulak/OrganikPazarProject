<div id="google_translate_element" style="display:none;"></div>

<script>
    let translateReady = false;

    function googleTranslateElementInit() {
        new google.translate.TranslateElement({
            pageLanguage: 'tr',
            includedLanguages: 'tr,en,fr',
            autoDisplay: false
        }, 'google_translate_element');

        const observer = new MutationObserver(() => {
            if (document.querySelector(".goog-te-combo")) {
                translateReady = true;
                observer.disconnect();
            }
        });
        observer.observe(document.body, { childList: true, subtree: true });
    }

    function setLanguage(lang, flagPath, text) {
        const applyLang = () => {
            const select = document.querySelector(".goog-te-combo");
            if (select) {
                select.value = lang;
                select.dispatchEvent(new Event("change"));
                document.getElementById("currentFlag").src = flagPath;
                document.getElementById("currentLang").textContent = text;

                localStorage.setItem("selectedLanguage", lang);
                localStorage.setItem("selectedFlag", flagPath);
                localStorage.setItem("selectedLangText", text);
            } else {
                setTimeout(applyLang, 400);
            }
        };
        applyLang();
    }

    document.addEventListener("DOMContentLoaded", () => {
        const savedLang = localStorage.getItem("selectedLanguage") || "tr";
        const savedFlag = localStorage.getItem("selectedFlag") || "/images/flags/tr.svg";
        const savedText = localStorage.getItem("selectedLangText") || "Türkçe";

        document.getElementById("currentFlag").src = savedFlag;
        document.getElementById("currentLang").textContent = savedText;

        const trySet = setInterval(() => {
            const select = document.querySelector(".goog-te-combo");
            if (select) {
                clearInterval(trySet);
                select.value = savedLang;
                select.dispatchEvent(new Event("change"));
            }
        }, 1000);
    });

    window.addEventListener("load", () => {
        const hideBar = () => {
            try {
                document.querySelectorAll(".goog-te-banner-frame, .goog-tooltip, #goog-gt-tt").forEach(el => {
                    el.style.display = "none";
                    el.style.visibility = "hidden";
                    el.style.opacity = "0";
                });

                document.body.style.top = "0px";

                if (window.top.document.querySelector("iframe.goog-te-banner-frame")) {
                    window.top.document.querySelector("iframe.goog-te-banner-frame").style.display = "none";
                }
            } catch {  }
        };
        hideBar();
        setTimeout(hideBar, 1000);
        setTimeout(hideBar, 3000);
    });
</script>

<script src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

<<style>
