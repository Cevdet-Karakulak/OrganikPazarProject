         display: none !important;
         visibility: hidden !important;
         opacity: 0 !important;
     }

     body {
         top: 0 !important;
     }
</style>

<script>
    (function() {
        function removeGoogleTranslateBar() {
            try {
                const frames = window.top.document.getElementsByTagName("iframe");
                for (let i = 0; i < frames.length; i++) {
                    const frame = frames[i];
                    if (frame.src.includes("translate.googleapis.com") || frame.className.includes("goog-te-banner-frame")) {
                        frame.style.display = "none";
                        frame.style.visibility = "hidden";
                        frame.style.opacity = "0";
                    }
                }

                window.top.document.body.style.top = "0px";

                const bannerDiv = window.top.document.querySelector("div#goog-gt-tt, div.skiptranslate");
                if (bannerDiv) bannerDiv.style.display = "none";
            } catch (e) {
                console.warn("Banner gizlenemedi, yeniden denenecek...");
            }
        }

        setInterval(removeGoogleTranslateBar, 1000);
    })();
</script>
