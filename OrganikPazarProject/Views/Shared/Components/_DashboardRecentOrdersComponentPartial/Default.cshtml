@model List<OrganikPazar.Entities.Order>

<div class="col-12 grid-margin stretch-card">
    <div class="card shadow-lg border-0">
        <div class="card-header text-white py-2 px-3"
             style="background: linear-gradient(90deg, #00b894, #009432); border-top-left-radius: 10px; border-top-right-radius: 10px;">
            <h5 class="mb-0 fw-semibold d-flex align-items-center gap-2">
                <i class="fas fa-receipt"></i> Son Siparişler
            </h5>
        </div>

        <div class="card-body bg-light p-3 overflow-auto">
            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle text-center mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Müşteri</th>
                            <th>Ürün</th>
                            <th>Adet</th>
                            <th>Durum</th>
                            <th>Tarih</th>
                            <th>Toplam Tutar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            string statusIcon = "";
                            string statusClass = "";

                            switch (item.Status)
                            {
                                case "Teslim Edildi":
                                    statusIcon = "<i class='fas fa-check-circle me-1'></i>";
                                    statusClass = "badge bg-success text-white";
                                    break;
                                case "Kargoda":
                                    statusIcon = "<i class='fas fa-truck me-1'></i>";
                                    statusClass = "badge bg-warning text-dark";
                                    break;
                                case "Beklemede":
                                    statusIcon = "<i class='fas fa-clock me-1'></i>";
                                    statusClass = "badge bg-info text-dark";
                                    break;
                                case "İptal Edildi":
                                    statusIcon = "<i class='fas fa-times-circle me-1'></i>";
                                    statusClass = "badge bg-danger text-white";
                                    break;
                                default:
                                    statusIcon = "<i class='fas fa-circle-notch me-1'></i>";
                                    statusClass = "badge bg-secondary";
                                    break;
                            }

                            <tr>
                                <td class="fw-semibold">@item.Customer?.Firstname @item.Customer?.Lastname</td>
                                <td>@item.Product?.Productname</td>
                                <td>@item.Quantity</td>
                                <td>
                                    <span class="@statusClass">@Html.Raw(statusIcon) @item.Status</span>
                                </td>
                                <td>@item.Orderdate?.ToString("dd.MM.yyyy")</td>
                                <td class="fw-semibold text-success">
                                    @String.Format(new System.Globalization.CultureInfo("tr-TR"), "{0:C2}", item.Totalprice)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 15px;
        overflow: hidden;
    }

    .card-header h5 {
        font-weight: 600;
        font-size: 1.05rem;
    }

    table th, table td {
        vertical-align: middle !important;
    }

    .badge {
        padding: 6px 10px;
        font-size: 0.85rem;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
    }

    .table-hover tbody tr:hover {
        background-color: #e8f5e9 !important;
        transition: background-color 0.2s ease-in-out;
    }

    .text-success {
        color: #09347a !important;
    }
</style>
